{
  "name": "ai-self-healing-playwright",
  "version": "1.0.0",
  "type": "module",
  "description": "A self-healing test automation framework using Playwright and Gemini AI.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:ci": "npx playwright test --reporter=line",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:api": "npx playwright test tests/api-contract.spec.ts --project=chromium",
    "test:a11y": "npx playwright test tests/accessibility.spec.ts --project=chromium",
    "test:perf": "npx playwright test tests/performance.spec.ts --project=chromium",
    "report": "npx playwright show-report",
    "qa:ci": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run test:ci && npm run qa:report",
    "qa:demo": "npx playwright test tests/healing-scenarios.spec.ts --project=chromium --reporter=line",
    "qa:report": "node scripts/qa-report.mjs",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@playwright/test": "^1.43.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.12.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "prettier": "^3.8.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
